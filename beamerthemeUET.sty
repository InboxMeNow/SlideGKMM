\ProvidesPackage{beamerthemeUET}[2026/08/23 Beamer Theme for VNU University of Engineering and Technology]

% -----------------------------------------------------------------------------
% Required Packages
% -----------------------------------------------------------------------------
\RequirePackage{xparse}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\RequirePackage{calc}
\RequirePackage{tcolorbox}
\RequirePackage{pifont}
\RequirePackage{amssymb}
\tcbuselibrary{skins,fitting}

% -----------------------------------------------------------------------------
% Color Palette Definition: Restrained Navy & Neutral Academic Scheme
% -----------------------------------------------------------------------------
\definecolor{uetblue}{RGB}{18, 55, 92}        % #12375C (Restrained Deep UET Navy)
\definecolor{uetdarkblue}{RGB}{12, 38, 66}    % #0C2642 (Deep Midnight Navy)
\definecolor{uetcyan}{RGB}{74, 107, 138}      % #4A6B8A (Muted Slate Steel)

% Secondary Accent (Muted Sage-Teal — used sparingly for role contrast)
\definecolor{uetgreen}{RGB}{46, 108, 97}      % #2E6C61 (Desaturated Academic Sage-Teal)
\definecolor{uetdarkgreen}{RGB}{34, 84, 75}   % #22544B (Deep Sage-Teal)
\definecolor{uetlightgreen}{RGB}{72, 134, 122}% #48867A (Soft Sage)
\definecolor{uetgreenbg}{RGB}{241, 246, 245}  % #F1F6F5 (Subtle Pale Sage Surface)

% Neutral & Background Colors (Clean White Theme)
\definecolor{uetdark}{RGB}{38, 46, 56}        % #262E38 (Charcoal Body Text)
\definecolor{uetgray}{RGB}{100, 112, 125}     % #64707D (Muted Slate Gray)
\definecolor{uetlightgray}{RGB}{246, 247, 249}% #F6F7F9 (Subtle Neutral Panel)
\definecolor{uetborder}{RGB}{212, 220, 228}   % #D4DCE4 (Subtle Hairline Border)
\definecolor{uetaccentbg}{RGB}{240, 244, 248} % #F0F4F8 (Pale Navy-Slate Surface)

% Semantic Warning/Deprecation Color (Muted Burgundy)
\definecolor{uetred}{RGB}{158, 52, 62}        % #9E343E (Muted Brick Burgundy)

% -----------------------------------------------------------------------------
% Beamer Color Mappings
% -----------------------------------------------------------------------------
\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{normal text}{fg=uetdark, bg=white}
\setbeamercolor{structure}{fg=uetblue}

\setbeamercolor{title}{fg=uetblue, bg=white}
\setbeamercolor{subtitle}{fg=uetgray, bg=white}
\setbeamercolor{author}{fg=uetdark, bg=white}
\setbeamercolor{institute}{fg=uetgray, bg=white}
\setbeamercolor{date}{fg=uetgray, bg=white}

\setbeamercolor{frametitle}{fg=uetblue, bg=white}
\setbeamercolor{framesubtitle}{fg=uetgray, bg=white}

\setbeamercolor{footline}{fg=uetgray, bg=white}
\setbeamercolor{item}{fg=uetblue}
\setbeamercolor{subitem}{fg=uetgray}
\setbeamercolor{subsubitem}{fg=uetblue}

\setbeamercolor{section in toc}{fg=uetblue}
\setbeamercolor{subsection in toc}{fg=uetdark}

% -----------------------------------------------------------------------------
% Font Settings
% -----------------------------------------------------------------------------
\setbeamerfont{title}{size=\Large, series=\bfseries}
\setbeamerfont{subtitle}{size=\small, series=\normalfont}
\setbeamerfont{author}{size=\normalsize, series=\bfseries}
\setbeamerfont{institute}{size=\footnotesize, series=\normalfont}
\setbeamerfont{date}{size=\footnotesize, series=\normalfont}

\setbeamerfont{frametitle}{size=\large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\footnotesize, series=\normalfont}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{size=\small, series=\bfseries}
\setbeamerfont{block body}{size=\small}

% -----------------------------------------------------------------------------
% Turn off standard navigation symbols
% -----------------------------------------------------------------------------
\setbeamertemplate{navigation symbols}{}

% -----------------------------------------------------------------------------
% Configurable University & Logo Strings
% -----------------------------------------------------------------------------
\newcommand{\univlogo}{assets/uet_logo.png}
\newcommand{\setunivlogo}[1]{\renewcommand{\univlogo}{#1}}

\newcommand{\facultylogo}{assets/fit_logo.png}
\newcommand{\setfacultylogo}[1]{\renewcommand{\facultylogo}{#1}}

\newcommand{\univname}{Trường Đại học Công nghệ -- Đại học Quốc gia Hà Nội}
\newcommand{\setunivname}[1]{\renewcommand{\univname}{#1}}

\newcommand{\univsubname}{Đại học Quốc gia Hà Nội}
\newcommand{\setunivsubname}[1]{\renewcommand{\univsubname}{#1}}

\newcommand{\authorlabel}{Sinh viên thực hiện:}
\newcommand{\setauthorlabel}[1]{\renewcommand{\authorlabel}{#1}}

\newcommand{\supervisorlabel}{Giảng viên:}
\newcommand{\setsupervisorlabel}[1]{\renewcommand{\supervisorlabel}{#1}}

\newcommand{\datelabel}{Ngày:}
\newcommand{\setdatelabel}[1]{\renewcommand{\datelabel}{#1}}

% Vietnamese date format default for \today
\AtBeginDocument{%
  \renewcommand{\today}{\ifnum\day<10 0\fi\number\day\ tháng \ifnum\month<10 0\fi\number\month\ năm \number\year}%
}

% -----------------------------------------------------------------------------
% Custom Frametitle Template (With Section Breadcrumb & Accent Bar)
% -----------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \vspace{0.32cm}%
  \begin{beamercolorbox}[wd=\paperwidth, leftskip=0.8cm, rightskip=0.8cm]{frametitle}
    \begin{minipage}[t]{0.70\textwidth}
      \usebeamerfont{frametitle}\insertframetitle\par
      \ifx\insertframesubtitle\@empty\else%
        \vspace{0.04cm}%
        {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
      \fi
    \end{minipage}%
    \hfill%
    \begin{minipage}[t]{0.28\textwidth}
      \raggedleft
      \ifx\insertsectionhead\@empty\else%
        {\fontsize{5.5pt}{6.5pt}\selectfont\color{uetgray}\textbf{\insertsectionhead}}%
      \fi
    \end{minipage}
  \end{beamercolorbox}%
  \vspace{0.10cm}%
  % Accent bar: Single-tone UET Navy rule
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=north west, inner sep=0pt, xshift=0.8cm] at (0,0) {
      \begin{tikzpicture}
        \draw[uetborder, line width=0.8pt] (0,0) -- (\paperwidth-1.6cm, 0);
        \draw[uetblue, line width=1.8pt] (0,0) -- (2.6cm, 0);
      \end{tikzpicture}
    };
  \end{tikzpicture}%
  \vspace{0.15cm}%
}

% -----------------------------------------------------------------------------
% Custom Footline Template (Bottom Footer: Logo + University Name)
% -----------------------------------------------------------------------------
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=0.46cm, dp=0.18cm]{footline}
    % Subtle separator line closer to text and logo
    \begin{tikzpicture}[remember picture, overlay]
      \draw[uetborder, line width=0.6pt] (0, 0.46cm) -- (\paperwidth, 0.46cm);
    \end{tikzpicture}%
    \hspace{0.8cm}%
    % Left: University Logo + University Name (Single clean line)
    \begin{minipage}[c]{0.60\paperwidth}
      \raggedright
      \IfFileExists{\univlogo}{%
        \parbox[c]{0.40cm}{\includegraphics[height=0.38cm, keepaspectratio]{\univlogo}}%
        \hspace{0.15cm}%
      }{}%
      \parbox[c]{0.52\paperwidth}{%
        {\fontsize{7.2pt}{8.5pt}\selectfont\textbf{\color{uetblue}\univname}}%
      }%
    \end{minipage}%
    \hfill%
    % Right: Short Title & Slide Number Badge
    \begin{minipage}[c]{0.30\paperwidth}
      \raggedleft
      \ifx\insertshorttitle\@empty\else
        {\fontsize{6.5pt}{7.5pt}\selectfont\color{uetgray}\insertshorttitle}\hspace{0.25cm}%
      \fi
      \tikz[baseline=-0.6ex]{
        \node[fill=uetlightgray, draw=uetborder, inner sep=2.5pt, text=uetblue, font=\fontsize{6.2pt}{7.2pt}\selectfont\bfseries] {
          \insertframenumber{}\,/\,\inserttotalframenumber
        };
      }%
    \end{minipage}%
    \hspace{0.8cm}%
  \end{beamercolorbox}%
}

% -----------------------------------------------------------------------------
% Itemize & Enumerate Styling (Monochrome Navy & Slate Badges)
% -----------------------------------------------------------------------------
\setbeamertemplate{itemize item}{%
  \tikz[baseline=-0.5ex]\node[fill=uetblue!85, inner sep=2.0pt]{};%
}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-0.5ex]\node[fill=uetgray, inner sep=1.5pt]{};%
}
\setbeamertemplate{itemize subsubitem}{%
  \tikz[baseline=-0.5ex]\node[draw=uetblue!85, line width=0.6pt, fill=white, inner sep=1.2pt]{};%
}

\setbeamertemplate{enumerate item}{%
  \tikz[baseline=-0.5ex]\node[fill=uetblue, inner sep=1.6pt, text=white, font=\fontsize{6.0pt}{6.0pt}\selectfont\bfseries]{\insertenumlabel};%
}
\setbeamertemplate{enumerate subitem}{%
  \tikz[baseline=-0.5ex]\node[fill=uetblue!75, inner sep=1.3pt, text=white, font=\fontsize{5.2pt}{5.2pt}\selectfont\bfseries]{\insertenumlabel.\insertsubenumlabel};%
}

% -----------------------------------------------------------------------------
% Custom Block Styling (Square corners)
% -----------------------------------------------------------------------------
\setbeamertemplate{block begin}{%
  \vspace{0.15cm}%
  \begin{tcolorbox}[
    colback=uetlightgray,
    colframe=uetblue,
    coltitle=white,
    title={\textbf{\insertblocktitle}},
    fonttitle=\small\bfseries,
    fontupper=\small,
    boxrule=0.7pt,
    sharp corners,
    arc=0pt,
    left=6pt, right=6pt, top=4pt, bottom=4pt,
    boxsep=1pt,
    shadow={0.8pt}{-0.8pt}{0pt}{black!6}
  ]%
}
\setbeamertemplate{block end}{%
  \end{tcolorbox}\vspace{0.1cm}%
}

\setbeamertemplate{block alerted begin}{%
  \vspace{0.15cm}%
  \begin{tcolorbox}[
    colback=uetred!6,
    colframe=uetred,
    coltitle=white,
    title={\textbf{\insertblocktitle}},
    fonttitle=\small\bfseries,
    fontupper=\small,
    boxrule=0.7pt,
    sharp corners,
    arc=0pt,
    left=6pt, right=6pt, top=4pt, bottom=4pt,
    boxsep=1pt,
    shadow={0.8pt}{-0.8pt}{0pt}{black!6}
  ]%
}
\setbeamertemplate{block alerted end}{%
  \end{tcolorbox}\vspace{0.1cm}%
}

\setbeamertemplate{block example begin}{%
  \vspace{0.15cm}%
  \begin{tcolorbox}[
    colback=uetgreenbg,
    colframe=uetgreen,
    coltitle=white,
    title={\textbf{\insertblocktitle}},
    fonttitle=\small\bfseries,
    fontupper=\small,
    boxrule=0.7pt,
    sharp corners,
    arc=0pt,
    left=6pt, right=6pt, top=4pt, bottom=4pt,
    boxsep=1pt,
    shadow={0.8pt}{-0.8pt}{0pt}{black!6}
  ]%
}
\setbeamertemplate{block example end}{%
  \end{tcolorbox}\vspace{0.1cm}%
}

% -----------------------------------------------------------------------------
% Table of Contents Styling
% -----------------------------------------------------------------------------
\setbeamertemplate{section in toc}{%
  \tikz[baseline=-0.5ex]\node[fill=uetblue, inner sep=2.0pt, text=white, font=\fontsize{7.0pt}{7.0pt}\selectfont\bfseries]{\inserttocsectionnumber};%
  \hspace{0.2cm}%
  \textbf{\color{uetblue}\inserttocsection}%
}

\setbeamertemplate{subsection in toc}{%
  \hspace{0.55cm}%
  \tikz[baseline=-0.5ex]\node[fill=uetblue!65, inner sep=1.4pt]{};%
  \hspace{0.15cm}%
  {\color{uetdark}\inserttocsubsection}%
}

% -----------------------------------------------------------------------------
% Custom Title Page Layout (Centered & Larger Title)
% -----------------------------------------------------------------------------
\newcommand{\supervisor}[1]{\def\@supervisor{#1}}
\newcommand{\studentid}[1]{\def\@studentid{#1}}
\newcommand{\department}[1]{\def\@department{#1}}
\supervisor{}
\studentid{}
\department{}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture, overlay]
    % Restrained geometric accents in Pale Navy
    \fill[uetblue!4] (current page.north east) -- ++(-4.5, 0) -- ++(4.5, -4.5) -- cycle;
    \fill[uetblue!8] (current page.north east) -- ++(-2.5, 0) -- ++(2.5, -2.5) -- cycle;
    \draw[uetblue!20, line width=1.0pt] ($(current page.north east)+(-5, 0)$) -- ($(current page.north east)+(0, -5)$);
    
    \draw[uetborder, line width=0.8pt] ($(current page.south west)+(0.8, 0.9)$) -- ($(current page.south east)+(-0.8, 0.9)$);
    \draw[uetblue, line width=2pt] ($(current page.south west)+(0.8, 0.9)$) -- ($(current page.south west)+(2.8, 0.9)$);
  \end{tikzpicture}%
  
  \vspace{-0.1cm}
  % Header: Larger Logo(s) & Vertically Centered University Name
  \begin{beamercolorbox}[wd=\textwidth]{titleheader}
    \IfFileExists{\facultylogo}{%
      \parbox[c]{2.85cm}{%
        \IfFileExists{\univlogo}{%
          \includegraphics[height=1.25cm, keepaspectratio]{\univlogo}%
        }{}%
        \hspace{0.2cm}%
        \includegraphics[height=1.25cm, keepaspectratio]{\facultylogo}%
      }%
      \hspace{0.25cm}%
      \parbox[c]{\textwidth - 3.4cm}{%
        {\fontsize{12pt}{15pt}\selectfont\bfseries\color{uetblue}\univname}%
        \ifx\@department\@empty\else%
          \\[2pt]{\fontsize{9.5pt}{12pt}\selectfont\color{uetgray}\textbf{\@department}}%
        \fi
      }%
    }{%
      \parbox[c]{1.35cm}{%
        \IfFileExists{\univlogo}{%
          \includegraphics[height=1.25cm, keepaspectratio]{\univlogo}%
        }{}%
      }%
      \hspace{0.25cm}%
      \parbox[c]{\textwidth - 1.8cm}{%
        {\fontsize{13pt}{16pt}\selectfont\bfseries\color{uetblue}\univname}%
        \ifx\@department\@empty\else%
          \\[2pt]{\fontsize{10pt}{12pt}\selectfont\color{uetgray}\textbf{\@department}}%
        \fi
      }%
    }%
  \end{beamercolorbox}

  \vspace{0.45cm}
  
  % Main Title & Subtitle Card (Centered & Larger Font)
  \begin{tcolorbox}[
    colback=uetaccentbg,
    colframe=uetblue!75,
    boxrule=0.8pt,
    sharp corners,
    arc=0pt,
    halign=center,
    left=14pt, right=14pt, top=13pt, bottom=13pt,
    shadow={1pt}{-1pt}{0pt}{black!4}
  ]
    {\fontsize{15pt}{24pt}\selectfont\bfseries\color{uetblue}\inserttitle}\par
    \ifx\insertsubtitle\@empty\else
      \vspace{0.15cm}%
      {\fontsize{11pt}{14pt}\selectfont\color{uetgray}\textbf{\insertsubtitle}}\par
    \fi
  \end{tcolorbox}
  
  \vspace{0.25cm}
  
  % Presenter & Details Info
  \begin{beamercolorbox}[wd=\textwidth]{titlebody}
    \begin{columns}[T]
      \begin{column}{0.55\textwidth}
        {\footnotesize
          \textbf{\color{uetblue}\authorlabel}\\[2pt]
          \hspace*{0.25cm}\parbox[t]{0.88\textwidth}{\insertauthor%
            \ifx\@studentid\@empty\else
              \ ({\color{uetgray}\@studentid})%
            \fi
          }
        }
      \end{column}
      \begin{column}{0.45\textwidth}
        {\footnotesize
          \ifx\@supervisor\@empty\else
            \textbf{\color{uetblue}\supervisorlabel}\\[2pt]
            \hspace*{0.25cm}\@supervisor\\[4pt]
          \fi
          \textbf{\color{uetblue}\datelabel}\\[2pt]
          \hspace*{0.25cm}\insertdate
        }
      \end{column}
    \end{columns}
  \end{beamercolorbox}
}

% -----------------------------------------------------------------------------
% Helper Card Environments & Metric Callouts (Square Corners)
% -----------------------------------------------------------------------------
\NewDocumentEnvironment{uetcard}{ O{} }{%
  \begin{tcolorbox}[
    colback=white,
    colframe=uetborder,
    boxrule=0.7pt,
    sharp corners,
    arc=0pt,
    left=6pt, right=6pt, top=3.5pt, bottom=3.5pt,
    boxsep=1pt,
    shadow={0.8pt}{-0.8pt}{0pt}{black!4},
    #1
  ]%
}{%
  \end{tcolorbox}%
}

\NewDocumentEnvironment{accentcard}{ O{uetblue} m O{} }{%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=uetborder,
    boxrule=0.6pt,
    leftrule=2.8pt,
    borderline west={2.8pt}{0pt}{#1},
    sharp corners,
    arc=0pt,
    title={\textbf{#2}\vphantom{gỐẬể}},
    coltitle=#1,
    fonttitle=\fontsize{8.2pt}{9.8pt}\bfseries\raggedright,
    colbacktitle=white,
    titlerule=0pt,
    left=5pt, right=5pt, top=2.8pt, bottom=2.8pt,
    boxsep=0.8pt,
    shadow={0.8pt}{-0.8pt}{0pt}{black!3},
    #3
  ]%
}{%
  \end{tcolorbox}%
}

% Stat / Big Metric Card Command
\newcommand{\statcard}[3][uetblue]{%
  \begin{tcolorbox}[
    colback=white,
    colframe=#1,
    sharp corners,
    arc=0pt,
    boxrule=0.8pt,
    halign=center,
    left=4pt, right=4pt, top=6pt, bottom=6pt,
    shadow={0.6pt}{-0.6pt}{0pt}{black!3}
  ]
    {\huge\bfseries\color{#1}#2}\\[2pt]
    {\scriptsize\color{uetdark}\textbf{#3}}
  \end{tcolorbox}%
}

% Checkmark & Crossmark shortcuts
\newcommand{\cmark}{\textcolor{uetgreen}{\ding{51}}}
\newcommand{\xmark}{\textcolor{uetred}{\ding{55}}}

% -----------------------------------------------------------------------------
% Automatic Section Divider Slide Template
% -----------------------------------------------------------------------------
\newcommand{\enableSectionSlides}{%
  \AtBeginSection[]{
    \begin{frame}[plain]
      \begin{tikzpicture}[remember picture, overlay]
        \fill[uetblue!4] (current page.north east) -- ++(-5.5, 0) -- ++(5.5, -5.5) -- cycle;
        \fill[uetblue!8] (current page.south west) -- ++(4.5, 0) -- ++(-4.5, 4.5) -- cycle;
      \end{tikzpicture}
      \centering\vfill
      \begin{tcolorbox}[
        colback=uetblue,
        colframe=uetblue,
        sharp corners,
        arc=0pt,
        halign=center,
        width=0.82\textwidth,
        boxrule=0pt,
        left=14pt, right=14pt, top=14pt, bottom=14pt,
        shadow={1.5pt}{-1.5pt}{0pt}{black!12}
      ]
        {\small\color{uetblue!18!white}\textbf{PART \Roman{section}}}\\[0.25cm]
        {\huge\bfseries\color{white}\insertsectionhead}
      \end{tcolorbox}
      \vfill
    \end{frame}
  }
}
